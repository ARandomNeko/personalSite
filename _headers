# Painting and font filenames contain content hashes, so updates get fresh URLs.
/paintings/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonts/*-LICENSE.txt
  Cache-Control: public, max-age=604800

/fonts/*-OFL.txt
  Cache-Control: public, max-age=604800
